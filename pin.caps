# Default capability pins — shipped by the v7.0.0 governance bail.
# Trust tier enforcement (T0-T3) applies as a floor on top of these.
#
# Grammar: a line per capability class. Tokens after `:` are space-separated
# allowlist entries; `deny:` tokens are kernel-defined denial classes.
# See https://ostk.ai/docs/pin-caps for the full spec.

# Read access — project root plus common AI-tooling state.
# ~/.claude/projects/ is read by the fcp-recall driver for transcript scans.
read: . ~/.claude/projects/ ~/.cache/ ~/.local/share/ostk/ /tmp/

# Write access — gated by `deny:` tokens below. `.ostk/` is broadly writable
# but write-kernel / modify-governance / write-secret block the load-bearing
# files (journal.jsonl, .primefile, ENTITYFILE, SECRET blocks in HUMANFILE).
write: .ostk/ ~/.cache/ostk/ /tmp/ /workspace/

# Shell execution. `governed` = the kernel's invariant-V capability gate
# (per-command policy + audit). `readonly` would forbid all mutations and
# break common dev workflows; `governed` is the right v7 default.
execute: shell(governed)

# Denial floor — overrides any allow above.
deny: write-kernel modify-governance write-secret
